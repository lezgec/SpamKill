# Public origin used to build OAuth callback URLs.
APP_URL=http://localhost:3000

# Google OAuth (Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra OAuth (Outlook)
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# 32-byte URL-safe secret used to encrypt local OAuth sessions.
APP_ENCRYPTION_KEY=

# Local MySQL/MariaDB (XAMPP default)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=spamkill
